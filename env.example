const pad = (n:number) => String(n).padStart(8,'0');
export function createSong(input:SongInput, offset=0):Song {
 const seed = Math.abs((input.mood+input.scene+(input.note||'')).split('').reduce((a,c)=>a+c.charCodeAt(0),0));
 const index = (seed + offset + Math.floor(Math.random()*library.length)) % library.length;
 const base = library[index];
 const now = new Date();
 const date = now.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}).toUpperCase();
 const code = `UT-${pad((Date.now()+Math.floor(Math.random()*9999))%100000000)}`;
 return {...base, date, code, template: (seed + offset + Math.floor(Math.random()*15)) % 15};
}
